# Required
TELEGRAM_BOT_TOKEN=

# Telegram chat id for the channel. Bot API channel ids are usually the
# public numeric id prefixed with -100. The channel id given for this
# project (4376417384) becomes:
TELEGRAM_CHAT_ID=-1004376417384

# TGCOIN (KZTG) jetton master address on TON
JETTON_ADDRESS=EQDpup8p2DKjPrf9Pk2Sv6mqVE7R2ktcgZ6r0vlklCLwph_G

# Optional: tonapi.io API key, raises rate limits (get one at https://tonconsole.com)
TONAPI_KEY=

# Cron schedules (evaluated in TZ_NAME)
POLL_CRON=*/10 * * * *
DAILY_CRON=0 9 * * *
TZ_NAME=Asia/Almaty

# Where to persist last-known holder count / last daily post date.
# On Railway, mount a Volume and point this at a path inside it, e.g. /data/state.json,
# otherwise state resets on every redeploy.
STATE_FILE_PATH=./data/state.json

# How many times to retry a single tonapi.io call (network errors, bad
# payloads, or a suspicious "0 holders" reading) before skipping the cycle.
TONAPI_MAX_ATTEMPTS=4

# Send a one-off "bot started" message to the channel on boot
SEND_STARTUP_NOTICE=false
